{
  "name": "@kovirlabs/tagkit",
  "version": "0.1.0",
  "description": "Copy-paste page templates and snippets in plain semantic HTML, build-time includes for static sites, and Pandoc and Jekyll themes. Styled by TagBrush.css, enhanced by TagAction, checked by TagCheck. No classes to learn, no framework.",
  "keywords": [
    "html",
    "templates",
    "snippets",
    "semantic-html",
    "classless",
    "tagbrush",
    "tagaction",
    "tagcheck",
    "llms-txt",
    "ai-agents"
  ],
  "homepage": "https://kovirlabs.github.io/tagkit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kovirlabs/tagkit.git"
  },
  "bugs": "https://github.com/kovirlabs/tagkit/issues",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "bin/",
    "src/",
    "templates/",
    "snippets/",
    "themes/",
    "snippets.json",
    "llms.txt",
    "ai/"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs",
    "test": "playwright test"
  },
  "devDependencies": {
    "@kovirlabs/tagcheck": "git+https://github.com/kovirlabs/tagcheck.git",
    "@playwright/test": "1.64.1",
    "tagaction": "git+https://github.com/kovirlabs/tagaction.git",
    "tagbrush": "1.1.0"
  },
  "bin": {
    "tagkit": "bin/tagkit.mjs"
  },
  "exports": {
    ".": "./src/include.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
