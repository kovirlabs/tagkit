  "bugs": "https://github.com/kovirlabs/tagkit/issues",
  "license": "Apache-2.0",
  "type": "module",
  "files": ["templates/", "snippets/", "snippets.json", "llms.txt", "ai/"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "tagaction": "git+https://github.com/kovirlabs/tagaction.git",
